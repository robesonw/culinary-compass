{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user who clicked"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instacart",
        "amazon_fresh",
        "amazon_supplement"
      ],
      "description": "Affiliate platform used"
    },
    "item_count": {
      "type": "integer",
      "description": "Number of items in the order (for grocery/meal kits)"
    },
    "supplement_name": {
      "type": "string",
      "description": "Name of supplement clicked (for supplement recommendations)"
    },
    "amazon_search_term": {
      "type": "string",
      "description": "Amazon search term used for supplement"
    },
    "estimated_order_value": {
      "type": "number",
      "description": "Estimated order value in USD"
    },
    "grocery_list_id": {
      "type": "string",
      "description": "ID of the grocery list or meal plan used (for grocery orders)"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the affiliate link was clicked"
    },
    "order_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user confirmed order completion"
    },
    "order_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user marked order as completed"
    }
  },
  "required": [
    "user_email",
    "platform"
  ]
}
{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user who clicked"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instacart",
        "amazon_fresh"
      ],
      "description": "Affiliate platform used"
    },
    "item_count": {
      "type": "integer",
      "description": "Number of items in the order"
    },
    "estimated_order_value": {
      "type": "number",
      "description": "Estimated total order value in USD"
    },
    "grocery_list_id": {
      "type": "string",
      "description": "ID of the grocery list or meal plan used"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the affiliate link was clicked"
    },
    "order_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user confirmed order completion"
    },
    "order_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user marked order as completed"
    }
  },
  "required": [
    "user_email",
    "platform",
    "item_count"
  ]
}
{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email of the user who referred"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the referred user (once they sign up)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "rewarded"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "reward_granted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the reward has been granted"
    }
  },
  "required": [
    "referrer_email",
    "referral_code"
  ]
}
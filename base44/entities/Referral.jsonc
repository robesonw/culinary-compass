{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email of the user who referred"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the referred user (once they sign up)"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code (e.g., VP-A3X9K)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "joined",
        "upgraded",
        "rewarded"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date when referred user joined"
    },
    "upgraded_date": {
      "type": "string",
      "format": "date",
      "description": "Date when referred user upgraded to Pro"
    },
    "reward_applied_date": {
      "type": "string",
      "format": "date",
      "description": "Date when reward was applied"
    },
    "referrer_reward_status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "used"
      ],
      "default": "pending",
      "description": "Status of referrer's reward"
    },
    "referred_reward_status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "used"
      ],
      "default": "pending",
      "description": "Status of referred user's reward"
    }
  },
  "required": [
    "referrer_email",
    "referral_code"
  ]
}
{
  "name": "WearableConnection",
  "type": "object",
  "properties": {
    "device_type": {
      "type": "string",
      "enum": [
        "fitbit",
        "garmin"
      ],
      "description": "Type of wearable device"
    },
    "device_name": {
      "type": "string",
      "description": "Name/model of the device (e.g., Fitbit Charge 5)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who connected"
    },
    "oauth_access_token": {
      "type": "string",
      "description": "OAuth access token (encrypted in storage)"
    },
    "oauth_refresh_token": {
      "type": "string",
      "description": "OAuth refresh token (encrypted in storage)"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the access token expires"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When device was connected"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful sync timestamp"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "disconnected"
      ],
      "default": "active",
      "description": "Current sync status"
    },
    "sync_error": {
      "type": "string",
      "description": "Error message if sync failed"
    }
  },
  "required": [
    "device_type",
    "user_email"
  ]
}